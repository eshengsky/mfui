    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "vue": "^3.5.25",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "tsx": "^4.21.0",
    "vite": "^7.2.6",
    "vue-tsc": "^3.1.8"
  }
}
