{
  "name": "mfui",
  "version": "0.0.0",
  "private": true,
  "description": "Message-first generative UI with portable text projections.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r build",
    "docs:build": "pnpm --filter @mfui/docs build",
    "docs:dev": "pnpm --filter @mfui/docs dev",
    "release:check": "pnpm typecheck && pnpm build && pnpm test && pnpm release:pack",
    "release:pack": "pnpm -r --filter './packages/*' pack --dry-run",
    "release:publish": "pnpm -r --filter './packages/*' publish --publish-branch main",
    "release:publish:otp": "pnpm -r --filter './packages/*' publish --publish-branch main --otp $NPM_OTP",
    "release:publish:dry-run": "pnpm -r --filter './packages/*' publish --dry-run --publish-branch main --no-git-checks",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
